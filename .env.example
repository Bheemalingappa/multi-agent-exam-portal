# ==============================================================================
# Multi-Agent Exam & Evaluation Portal - Environment Variables Template
# ==============================================================================
# Copy this file to .env and replace placeholders with actual configuration.
# DO NOT commit real secrets or production credentials to source control.

# API Gateway Configuration
PROJECT_NAME="Multi-Agent Exam & Evaluation Portal"
API_V1_STR="/api/v1"
LOG_LEVEL="INFO"

# AI Provider Configuration (Google Gemini SDK)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Database Connection (Amazon RDS PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://<db-user>:<db-password>@<rds-endpoint-placeholder>:5432/<db-name>

# Cache Connection (Amazon ElastiCache Redis)
# Format: redis://<host>:<port>/<db-index>
REDIS_URL=redis://<redis-endpoint-placeholder>:6379/0
REDIS_BROKER_URL=redis://<redis-endpoint-placeholder>:6379/0

# Security & JWT Authentication
# Generate a 256-bit secret key for production (e.g. `openssl rand -hex 32`)
JWT_SECRET=<generate-secure-jwt-secret-placeholder>
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# Multi-Agent Consensus Engine Configuration
MAX_A2A_ROUNDS=3
ENABLE_ANOMALY_ORACLE=true
ENABLE_MCP_CONTEXT=true

# CORS Configuration
CORS_ORIGINS="*"

# AWS Deployment Configuration
AWS_REGION=us-east-1

# Frontend Configuration
VITE_API_BASE_URL=/api/v1
VITE_API_BASE_URL_LOCAL=http://localhost:8000/api/v1
VITE_WS_BASE_URL_LOCAL=ws://localhost:8000/api/v1
